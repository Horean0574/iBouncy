{
  "name": "ibouncy",
  "version": "1.0.0",
  "description": "iBouncy - an elegant, high-performance Canvas bounce game built with LeaferJS",
  "main": "src/app.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ api/",
    "lint:fix": "eslint --fix src/ api/",
    "format": "prettier --write 'src/**/*.ts' 'api/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'api/**/*.ts'",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeSky0/iBouncy.git"
  },
  "keywords": ["game", "canvas", "leafer", "typescript", "vite"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CodeSky0/iBouncy/issues"
  },
  "homepage": "https://github.com/CodeSky0/iBouncy#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cookie": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "leafer-game": "^1.12.4",
    "nodemailer": "^9.0.3"
  }
}
